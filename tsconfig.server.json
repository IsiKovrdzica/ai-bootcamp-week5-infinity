{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": [
    "server/**/*.ts",
    "scripts/verify-gemini.ts",
    "scripts/verify-gemini-fallback-capability.ts",
    "scripts/verify-training-live.ts"
  ]
}
