{
  "name": "brickpulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "check:frontend-boundary": "node scripts/check-frontend-boundary.mjs",
    "verify:gemini": "node --env-file=.env --import tsx scripts/verify-gemini.ts",
    "verify:gemini:fallback-capability": "node --env-file=.env --import tsx scripts/verify-gemini-fallback-capability.ts",
    "verify:training:live": "node --env-file=.env --import tsx scripts/verify-training-live.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build && tsc -p tsconfig.server.build.json",
    "preview": "vite preview",
    "dev:server": "node --env-file=.env --import tsx --watch server/index.ts",
    "dev:all": "node scripts/dev.mjs",
    "start:server": "node dist-server/server/index.js",
    "build:server": "tsc -p tsconfig.server.build.json"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "playwright": "^1.63.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@google/genai": "2.24.0"
  }
}
